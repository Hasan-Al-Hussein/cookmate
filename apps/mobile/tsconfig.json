{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["jest", "react"],
    "noEmit": true
  },
  "include": ["app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.node.ts", "src/**/*.test-support.ts"]
}
