# Reference template only: never put real credentials in this workspace or OneDrive.
# The private operator file is %LOCALAPPDATA%\CookMate\gateway.env.
# A key already exists there on the development laptop; do not overwrite that file.
# Merge only missing configuration names privately. Never print the resulting file.
# Empty required values intentionally prevent launch; no model or TLS fallback exists.

# Existing Gemini credential, supplied only through the private operator file.
GEMINI_API_KEY=

# Explicitly select gemini-3.5-flash-lite or gemini-3.8-flash after model evaluation.
# No model winner is established; current live requests remain held after quota failure.
COOKMATE_MODEL=

# Absolute paths outside the workspace to an operator-managed certificate/private key.
# The certificate must match the phone endpoint and be trusted by iOS.
COOKMATE_TLS_CERT=
COOKMATE_TLS_KEY=

# Safe loopback default. Phone access requires a deliberately selected local IPv4
# interface and verified trusted transport; 127.0.0.1 on the phone is not the laptop.
COOKMATE_BIND_HOST=127.0.0.1
COOKMATE_PORT=3443

# LOCALAPPDATA is inherited from Windows. Pairing registry storage is under
# %LOCALAPPDATA%\CookMate\registry. Do not place TLS keys, pairing state or provider
# credentials in EXPO_PUBLIC_* or phone configuration.
